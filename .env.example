# This project does not automatically load .env files.
# Set this in the current shell only; do not commit real secrets.
# --provider openai uses only these settings. No fixed GPT model is assumed.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=replace-with-your-accessible-gpt-model-id

# The default compatible provider uses only these settings.
# OPENAI_API_KEY is never used for this provider.
FEEDBACK_API_KEY=replace-with-your-compatible-provider-key
FEEDBACK_BASE_URL=https://your-provider.example/v1
FEEDBACK_MODEL=replace-with-your-compatible-model-id
